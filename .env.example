# PostgreSQL connection (docker-compose default shown)
DATABASE_URL="postgresql://critterops:critterops@localhost:5432/critterops?schema=public"

# Sign session cookies. Change in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Public site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Square — staff collect payments (Terminal / POS / keyed card). Clients never pay in CritterOps.
# Sandbox values from https://developer.squareup.com/apps
SQUARE_ENVIRONMENT="sandbox"
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
NEXT_PUBLIC_SQUARE_APPLICATION_ID=""

# Optional quote delivery + en-route texts (fallback links work without these)
# RESEND_API_KEY=""
# MESSAGING_FROM_EMAIL="CritterOps <quotes@thewildlifepros.com>"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# Google Sheets — one workbook, later syncs update/append (they do not create a new file)
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"...","private_key":"..."}'
# GOOGLE_SHEETS_OWNER_EMAIL="admin@thewildlifepros.com"
# GOOGLE_SHEETS_SPREADSHEET_ID=""

# Google Calendar — push scheduled jobs to each technician's Google Calendar (same service account).
# Requires domain-wide delegation on the service account with scope:
# https://www.googleapis.com/auth/calendar
# Set GOOGLE_CALENDAR_SYNC=false to disable without removing the JSON key.

# Optional maps. Navigation links always use the street address (GPS is only a fallback pin).
# Recommended (free, no credit card): OpenRouteService for geocoding, road-distance optimize, and map path.
# OPENROUTESERVICE_API_KEY=""
# Optional Mapbox (requires billing card on their free tier):
# MAPBOX_TOKEN=""
# Without either key, geocoding uses OpenStreetMap Nominatim (1 request/sec) and optimization uses straight-line miles.
# The Routes map preview uses free Carto basemap tiles.
# NOMINATIM_USER_AGENT="CritterOps/0.1 (The Wildlife Pros)"
